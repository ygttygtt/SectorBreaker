# LLM
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Search providers
SEARCH_PROVIDER_MODE=auto

TAVILY_API_KEY=
TAVILY_ENDPOINT=https://api.tavily.com/search

SERPER_API_KEY=
SERPER_ENDPOINT=https://google.serper.dev/search

BRAVE_API_KEY=
BRAVE_ENDPOINT=https://api.search.brave.com/res/v1/web/search

EXA_API_KEY=
EXA_ENDPOINT=https://api.exa.ai/search

# Firecrawl can be used for both search discovery and content extraction.
FIRECRAWL_API_KEY=
FIRECRAWL_SEARCH_ENDPOINT=https://api.firecrawl.dev/v2/search

# Content extraction provider selection: http | firecrawl | jina
CONTENT_EXTRACTION_PROVIDER=http

# Firecrawl extractor
FIRECRAWL_ENDPOINT=https://api.firecrawl.dev/v1/scrape

# Jina Reader extractor
JINA_READER_ENDPOINT_PREFIX=https://r.jina.ai/http://

# Local runtime paths
SECTORBREAKER_DB_PATH=data/sectorbreaker.sqlite3
SECTORBREAKER_EXPORT_ROOT=exports

# Local semantic retrieval: auto | fastembed | disabled
SECTORBREAKER_EMBEDDING_PROVIDER=auto
SECTORBREAKER_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Defaults to ~/.cache/sectorbreaker/fastembed when blank
SECTORBREAKER_EMBEDDING_CACHE_DIR=
SECTORBREAKER_EMBEDDING_THREADS=
